  "status": "static-semantics-checked",
  "scope": "01–07 and 11 chapters. No UE/MCP/UBT, no public media or archive changes, no 08/09 chapter edits.",
  "method": "Compare doc fields with existing native configuration manifest; directly inspect original Cooldown, component ActionSet and Dash-direction PNGs; read native clipboard links and current local C++/INI.",
  "corrections": [
    {
      "file": "content/docs/02-architecture/experience.mdx",
      "finding": "Candidate IsValid means syntactically valid ID, not asset existence. A missing URL override skips World Settings and fails into final fallback; component screenshot array index 1 is the second element."
    },
    {
      "file": "content/docs/04-gas/ability-sets.mdx",
      "finding": "The actual Blueprint variable label is Cooldown, not Cooldown Time. Its CDO value is distinct from runtime assignment and Gameplay Effect."
    },
    {
      "file": "content/docs/04-gas/dash-blueprint.mdx",
      "finding": "Delta A is movement, B is facing. abs yaw <45 selects forward/true; >135 backward/false; remaining negative left, otherwise right. Exact 45/135 boundaries go sideways."
    },
    {
      "file": "content/docs/03-character/jump-blueprint.mdx",
      "finding": "State Jumping with EndCurrentState true; WaitInputRelease TestAlreadyReleased true and OnRelease drives EndAbility; state end/interruption both stop jumping; UI ContextObject is ASC Owner, PlayerState in this Lyra character."
    },
    {
      "file": "content/docs/03-character/enhanced-input.mdx",
      "finding": "Input_Move X is right and Y forward, explaining W Swizzle YXZ. This differs from any independent BlendSpace axis contract."
    },
    {
      "file": "content/docs/06-ui/extensions.mdx",
      "finding": "Empty configured DataClasses still permits UUserWidget. Extension points also register global, LocalPlayer and PlayerState contexts, explaining owner-context Jump UI."
    },
    {
      "file": "content/docs/06-ui/settings-mvvm.mdx",
      "finding": "Official Lyra already has GameSettings language staging/application and localized Game resources; MMO Target, UI text and ViewModel refresh are tutorial additions. Editor language alone does not verify game language."
    },
    {
      "file": "content/docs/11-reference/upgrades.mdx",
      "finding": "Compilation cannot verify semantic ordering of same-type pins. Document separate static source, native graph, compile and runtime evidence."
    }
  ],
