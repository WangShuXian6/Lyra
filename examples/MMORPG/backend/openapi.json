{
  "openapi": "3.1.0",
  "info": {
    "title": "Lyra 教学 MMORPG Backend",
    "version": "1.0.0",
    "description": "Native Unreal Program. Client bearer tokens and the separately provisioned server secret use the same Authorization header on their respective routes. Secrets never belong in game client builds."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8088"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Database-backed readiness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Register an account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "accountId"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Replace existing login session with a new opaque token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "const": 86400
                    }
                  },
                  "required": [
                    "token",
                    "expiresIn"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Revoke login session and unconsumed tickets",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/characters": {
      "get": {
        "summary": "List characters owned by the session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "characters": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Character"
                      }
                    }
                  },
                  "required": [
                    "characters"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create at most eight characters per account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 24
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Character"
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/join-ticket": {
      "post": {
        "summary": "Issue one-use ticket for owned character",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "characterId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "serverId": {
                    "type": "string",
                    "const": "local-1"
                  }
                },
                "required": [
                  "characterId",
                  "serverId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket": {
                      "type": "string"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "const": 60
                    },
                    "address": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ticket",
                    "expiresIn",
                    "address"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/server/consume-ticket": {
      "post": {
        "summary": "Server secret required; consume ticket and atomically acquire 120-second lease",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "string"
                  },
                  "serverId": {
                    "type": "string",
                    "const": "local-1"
                  }
                },
                "required": [
                  "ticket",
                  "serverId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "leaseToken": {
                      "type": "string"
                    },
                    "character": {
                      "$ref": "#/components/schemas/Character"
                    }
                  },
                  "required": [
                    "leaseToken",
                    "character"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/server/load": {
      "post": {
        "summary": "Server secret + active lease required; load committed character",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Lease"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "character": {
                      "$ref": "#/components/schemas/Character"
                    }
                  },
                  "required": [
                    "character"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/server/save": {
      "post": {
        "summary": "Server secret + lease; save complete snapshot with version and idempotency",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Save"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "version"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/server/heartbeat": {
      "post": {
        "summary": "Server secret + active lease required; heartbeat",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Lease"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/server/release": {
      "post": {
        "summary": "Server secret + active lease required; release",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Lease"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Structured error; 400 invalid input, 401 authentication, 403 lease/server identity, 404 ownership, 409 conflict, 503 database or queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,32}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "State": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          },
          "health": {
            "type": "number",
            "minimum": 0
          },
          "mana": {
            "type": "number",
            "minimum": 0
          },
          "inventory": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "itemId",
                "quantity"
              ]
            }
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          }
        },
        "required": [
          "level",
          "xp",
          "health",
          "mana",
          "inventory",
          "position"
        ]
      },
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/State"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "state"
        ]
      },
      "Lease": {
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "format": "uuid"
          },
          "leaseToken": {
            "type": "string"
          },
          "serverId": {
            "type": "string",
            "const": "local-1"
          }
        },
        "required": [
          "characterId",
          "leaseToken",
          "serverId"
        ]
      },
      "Save": {
        "type": "object",
        "properties": {
          "characterId": {
            "type": "string",
            "format": "uuid"
          },
          "leaseToken": {
            "type": "string"
          },
          "serverId": {
            "type": "string",
            "const": "local-1"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          }
        },
        "required": [
          "characterId",
          "leaseToken",
          "serverId",
          "expectedVersion",
          "requestId",
          "state"
        ]
      }
    }
  }
}
