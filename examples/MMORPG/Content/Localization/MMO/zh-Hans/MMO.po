msgstr "该账号已有在线角色，请先退出当前会话。"

#. Key:	CharacterLimit
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(42)
#: Source/MMORPG/Private/MMOUI.cpp(42)
msgctxt "MMOUI,CharacterLimit"
msgid "This account has reached the character limit."
msgstr "该账号的角色数量已达上限。"

#. Key:	InvalidTicket
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(43)
#: Source/MMORPG/Private/MMOUI.cpp(43)
msgctxt "MMOUI,InvalidTicket"
msgid "The join ticket expired or was already used. Request a new ticket."
msgstr "入服票据已过期或已使用，请重新申请。"

#. Key:	InvalidInput
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(44)
#: Source/MMORPG/Private/MMOUI.cpp(44)
msgctxt "MMOUI,InvalidInput"
msgid "Check the account name, password (12 or more characters), and character name."
msgstr "请检查账号名称、密码（至少 12 个字符）和角色名称。"

#. Key:	Unauthorized
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(45)
#: Source/MMORPG/Private/MMOUI.cpp(45)
msgctxt "MMOUI,Unauthorized"
msgid "The account or password is incorrect, or your session expired. Sign in again."
msgstr "账号或密码不正确，或登录已过期，请重新登录。"

#. Key:	Forbidden
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(46)
#: Source/MMORPG/Private/MMOUI.cpp(46)
msgctxt "MMOUI,Forbidden"
msgid "You do not have permission to perform this operation."
msgstr "你没有执行此操作的权限。"

#. Key:	CharacterUnavailable
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(47)
#: Source/MMORPG/Private/MMOUI.cpp(47)
msgctxt "MMOUI,CharacterUnavailable"
msgid "This character or service resource is unavailable."
msgstr "该角色或服务资源不可用。"

#. Key:	BackendUnavailable
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(48)
#: Source/MMORPG/Private/MMOUI.cpp(48)
msgctxt "MMOUI,BackendUnavailable"
msgid "The backend is unavailable. Check that the service and database are running."
msgstr "后端服务不可用，请检查服务与数据库是否正在运行。"

#. Key:	BackendRequestFailed
#. SourceLocation:	Source/MMORPG/Private/MMOUI.cpp(49)
#: Source/MMORPG/Private/MMOUI.cpp(49)
msgctxt "MMOUI,BackendRequestFailed"
msgid "Request failed (HTTP {0}). Please try again."
msgstr "请求失败（HTTP {0}），请重试。"
